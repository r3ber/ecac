    "    features : np.ndarray\n",
    "        Matriz de features (shape: n_samples x n_features)\n",
    "    labels : np.ndarray\n",
    "        Vetor de labels/atividades (shape: n_samples)\n",
    "    nomes_features : list\n",
    "        Lista com os nomes das features\n",
    "    output_path : str\n",
    "        Caminho do arquivo CSV a ser criado\n",
    "    \"\"\"\n",
    "    # Criar DataFrame com as features\n",
    "    df = pd.DataFrame(features, columns=nomes_features)\n",
    "    \n",
    "    # Adicionar a coluna de labels\n",
    "    df['activity_label'] = labels\n",
    "    \n",
    "    # Salvar em CSV\n",
    "    df.to_csv(output_path, index=False)\n",
    "    print(f\"Feature set salvo em {output_path}\")\n",
    "    print(f\"Shape: {df.shape} (linhas x colunas)\")\n",
    "    print(f\"Primeiras 5 linhas:\")\n",
    "    print(df.head())\n",
    "    \n",
    "    return df\n",
    "\n",
    "# Executar\n",
    "df_features = save_feature_set_to_csv(features, labels, nomes_features, output_path='../feature_set.csv')"
