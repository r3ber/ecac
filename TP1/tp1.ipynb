    "from scipy import stats\n",
    "# zscore = (valor - média) / desvio_padrão\n",
    "def detect_outliers_zscore (samples, k):\n",
    "    z_scores = stats.zscore(samples, nan_policy='omit')\n",
    "    return np.abs(z_scores) > k\n"
